# 环境变量配置说明
# 部署到 Cloudflare Pages 时，需要在项目设置中配置以下环境变量
# 位置：Cloudflare Dashboard → Pages → 你的项目 → Settings → Environment variables

# ========== 数据库配置（必填） ==========
# Neon PostgreSQL 数据库连接字符串
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# ========== 管理员账号配置（必填） ==========
# 管理员登录用户名
ADMIN_USERNAME=管理员用户名

# 管理员登录密码
ADMIN_PASSWORD=管理员密码

# 管理员 Session Token 签名密钥（任意随机字符串，建议至少 32 位）
ADMIN_TOKEN_SECRET=your-secret-key-here-change-this-to-random-string

# ========== 成绩防伪配置（可选，有默认值） ==========
# 成绩防伪校验码 HMAC 签名密钥（不配置则使用默认值）
VERIFICATION_HMAC_SECRET=neepu-auto-grade-verify-2026
